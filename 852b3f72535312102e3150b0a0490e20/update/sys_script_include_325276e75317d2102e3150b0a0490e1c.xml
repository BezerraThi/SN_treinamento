    blockDuplicateTrainings: function(){
        var course = this.getParameter("sysparm_course");
        var date = this.getParameter("sysparm_training_date");
 
        var grTraining = new GlideRecord("x_1588982_treina_0_agenda");
        grTraining.addQuery("training_date", date);
        grTraining.addQuery("course", course);
        grTraining.query();
 
        return grTraining.hasNext() ? "true" : "false";
    },
 
    type: 'GlideAjax'
 
   
});]]></script>
